# Configuration Imo-SN - Variables d'environnement pour Render / Local
PORT=10000
PUBLIC_URL=https://imo-sn.onrender.com
FRONTEND_URL=https://imo-sn.onrender.com
JWT_SECRET=votre_cle_secrete_jwt_tres_longue_et_securisee

# Base de données MongoDB (Atlas ou locale)
MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster0.mongodb.net/imo-sn?retryWrites=true&w=majority

# Configuration Envoi E-mails OTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application

# Paiements PayDunya (Abonnements & Vidéos)
PAYDUNYA_MASTER_KEY=remplacer_par_votre_master_key
PAYDUNYA_PRIVATE_KEY=remplacer_par_votre_private_key
PAYDUNYA_TOKEN=remplacer_par_votre_token
PAYDUNYA_MODE=live
